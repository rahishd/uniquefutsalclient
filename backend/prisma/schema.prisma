generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  phoneNumber          String                   @id
  email                String?                  @unique
  password             String
  name                 String?
  role                 String                   @default("user")
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  avatar               String?
  freeMatchesAvailable Int                      @default(0)
  isVerified           Boolean                  @default(false)
  loyaltyEligible      Boolean                  @default(false)
  loyaltyProgress      Int                      @default(0)
  dateOfBirth          String? // YYYY-MM-DD, asked at sign-up; set once (staff change it)
  googleSub            String?                  @unique
  googleEmail          String?
  loginCount           Int                      @default(0) // sign-ins so far; the app hides "New" tags after a few
  emergencyName        String? // who to call if this player is hurt (asked at sign-up; the app reminds those who skipped)
  emergencyPhone       String? // 10-digit mobile, never the account's own number
  emergencyRelation    String? // e.g. Father, Wife, Friend (optional)
  bookings             Booking[]
  subscriptions        MembershipSubscription[]
  notifications        Notification[]
  orders               Order[]
  reviews              Review[]
  transactions         Transaction[]

  @@index([dateOfBirth])
}

model Product {
  id                String         @id @default(cuid())
  name              String
  description       String?
  price             Float
  categoryId        String
  inventory         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lowStockThreshold Int            @default(10)
  unit              String         @default("pcs")
  costPrice         Float?
  logs              InventoryLog[]
  orderItems        OrderItem[]
  category          Category       @relation(fields: [categoryId], references: [id])
  reviews           Review[]
}

model InventoryLog {
  id           String   @id @default(cuid())
  productId    String
  change       Int
  price        Float?
  reason       String?
  createdAt    DateTime @default(now())
  cashAmount   Float    @default(0)
  onlineAmount Float    @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Order {
  id          String       @id @default(cuid())
  userId      String
  totalPrice  Float
  status      String       @default("pending")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [phoneNumber])
  items       OrderItem[]
  payment     Payment?
  transaction Transaction?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  amount        Float
  status        String   @default("pending")
  paymentMethod String?
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  orderId     String?  @unique
  amount      Float
  type        String
  description String?
  createdAt   DateTime @default(now())
  order       Order?   @relation(fields: [orderId], references: [id])
  user        User     @relation(fields: [userId], references: [phoneNumber])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [phoneNumber])

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("general")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  href      String?
  dedupeKey String?  @unique
  user      User     @relation(fields: [userId], references: [phoneNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  changes   String?
  userId    String?
  createdAt DateTime @default(now())
}

model Booking {
  id               String    @id @default(cuid())
  userId           String?
  date             String
  startTime        String
  endTime          String
  duration         Int
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  basePrice        Float
  addOns           String?
  addOnsPrice      Float     @default(0)
  promoCode        String?
  discountAmount   Float     @default(0)
  subtotal         Float
  totalPrice       Float
  paymentMethod    String
  amountPaidNow    Float     @default(0)
  remainingAmount  Float     @default(0)
  paymentStatus    String    @default("pending")
  status           String    @default("pending")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  cashAmount       Float     @default(0)
  onlineAmount     Float     @default(0)
  waterBottles     Int       @default(0)
  clubDiscount     Int       @default(0) // Unique Club discount included in discountAmount
  loyaltyEnabled   Boolean   @default(true)
  source           String    @default("regular")
  challengeId      String?
  voucherId        String?
  cancelledAt      DateTime?
  holdExpiresAt    DateTime?
  checkedInAt      DateTime?
  paymentOrderCode String?
  code             String?
  user             User?     @relation(fields: [userId], references: [phoneNumber])

  @@index([userId])
  @@index([date])
  @@index([customerPhone])
  @@index([code])
  @@index([status])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  itemName  String
  category  String
  quantity  String?
  price     Float
  date      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tournament {
  id            String         @id @default(cuid())
  name          String
  prizePool     Float
  minTeams      Int
  maxTeams      Int
  startDate     String
  endDate       String
  isActive      Boolean        @default(true)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?
  paymentStatus String         @default("unpaid")
  status        String         @default("active")
  totalAmount   Float          @default(0)
  hostedEvent   Boolean        @default(false)
  entryFee      Float          @default(0) // per team, in rupees; 0 = free entry. Staff set it in the admin portal.
  hostName      String?
  hostPhone     String?
  minRate       Int?
  billClosedAt  DateTime?
  createdBy     String?
  days          TournamentDay[]
  registrations Registration[]
}

model TournamentDay {
  id           String     @id @default(cuid())
  tournamentId String
  date         String
  startHour    Int
  endHour      Int
  blockIds     String[]
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, date])
}

model Registration {
  id           String     @id @default(cuid())
  tournamentId String
  teamName     String
  captainName  String
  contactEmail String
  contactPhone String
  players      String
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model GamezoneRecord {
  id           String   @id @default(cuid())
  customerName String
  hours        Float
  rate         Float
  money        Float
  date         String
  timestamp    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MembershipPlan {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  price                  Float
  perks                  String
  featured               Boolean                  @default(false)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  pricingMatrix          String?
  price1MonthDay         Int?
  price1MonthEvening     Int?
  price1MonthMorning     Int?
  price3DaysDay          Int?
  price3DaysEvening      Int?
  price3DaysMorning      Int?
  price3MonthsDay        Int?
  price3MonthsEvening    Int?
  price3MonthsMorning    Int?
  discount1MonthDay      Int?                     @default(0)
  discount1MonthEvening  Int?                     @default(0)
  discount1MonthMorning  Int?                     @default(0)
  discount3DaysDay       Int?                     @default(0)
  discount3DaysEvening   Int?                     @default(0)
  discount3DaysMorning   Int?                     @default(0)
  discount3MonthsDay     Int?                     @default(0)
  discount3MonthsEvening Int?                     @default(0)
  discount3MonthsMorning Int?                     @default(0)
  subscriptions          MembershipSubscription[]
}

model MembershipSubscription {
  id                String         @id @default(cuid())
  planId            String
  userId            String
  startDate         DateTime
  endDate           DateTime
  status            String         @default("pending")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paymentStatus     String         @default("pending")
  paymentVerifiedAt DateTime?
  paymentVerifiedBy String?
  timeSlot          String?
  chosenCategory    String?
  chosenDuration    String?
  totalPrice        Float?
  chosenDays        String[]
  discountAmount    Float          @default(0)
  promoCode         String?
  notes             String?
  excludeDays       String[]
  memberCode        String?        @unique
  plan              MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [phoneNumber])
}

model SuperAdmin {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Ad {
  id        String   @id @default(cuid())
  image     String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  image       String
  title       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserOTP {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  otp         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model PendingSignup {
  phoneNumber String   @id
  name        String
  email       String?
  dateOfBirth String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  password    String
  otp         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model PageVisit {
  id        String   @id @default(cuid())
  date      String
  page      String   @default("/")
  userAgent String?
  createdAt DateTime @default(now())
}

// ===================================================================
// New customer app (additive only: new tables, no changes to old data).
// User references below are phone numbers (User.phoneNumber), kept as plain strings.
// ===================================================================

model UserPrefs {
  userId             String   @id
  smsReminders       Boolean  @default(true)
  promoNotifications Boolean  @default(true)
  popupReminder      Boolean  @default(true)
  language           String   @default("en")
  mode               String   @default("player") // player | captain
  location           String?
  position           String? // GK | DEF | MID | FWD
  updatedAt          DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PaymentOrder {
  id         String    @id @default(cuid())
  orderCode  String    @unique // the booking / gamezone / membership code shown to the customer
  purpose    String // game | gamezone | purchase | renew
  userId     String?
  guestPhone String?
  method     String // fonepay | venue (older rows may say esewa)
  amount     Int
  status     String    @default("pending") // pending | paid | expired | failed | refunded
  remarks    String
  qrPayload  String?
  gatewayRef String?
  expiresAt  DateTime
  paidAt     DateTime?
  paidBy     String? // staff id for venue payments
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  orderCode  String
  source     String // gateway | staff | system
  payload    String
  receivedAt DateTime @default(now())

  @@index([orderCode])
}

model LoyaltyEntry {
  id         String   @id @default(cuid())
  userId     String
  kind       String // game | captain_win | goods | membership | free_game | referral | goal_rush | gift | watch_earn
  points     Decimal  @db.Decimal(8, 1) // positive = earned, negative = spent on a free game
  earnedOn   String // YYYY-MM-DD
  expiresOn  String? // last valid day; null = never expires
  sourceType String
  sourceId   String
  detail     String
  createdAt  DateTime @default(now())

  @@unique([kind, sourceType, sourceId])
  @@index([userId])
}

model FreeGameVoucher {
  id        String    @id @default(cuid())
  userId    String
  period    String // Morning | Day | Evening
  cost      Decimal   @db.Decimal(8, 1)
  status    String    @default("unused") // unused | used | void
  bookingId String?
  claimedAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId, status])
}

model GoodsSale {
  id     String   @id @default(cuid())
  userId String?
  phone  String?
  amount Int
  items  String?
  soldBy String
  customerName String?
  bookingId    String?
  soldAt DateTime @default(now())
}

model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  area      String       @default("Tilottama")
  captainId String       @unique
  createdAt DateTime     @default(now())
  members   TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String   @unique // a player can be in only one team
  position String   @default("MID")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Challenge {
  id               String            @id @default(cuid())
  challengerTeamId String
  challengedTeamId String
  type             String // match | competition
  date             String
  startHour        Int
  courtPrice       Int
  loserPct         Int // 70 | 60 | 100
  message          String?
  status           String            @default("pending") // pending | accepted | declined | cancelled | expired
  bookingId        String?
  venuePaidAt      DateTime?
  venuePaidBy      String?
  createdAt        DateTime          @default(now())
  results          ChallengeResult[]

  @@index([challengerTeamId])
  @@index([challengedTeamId])
}

model ChallengeResult {
  id                String    @id @default(cuid())
  challengeId       String
  submittedByTeamId String
  scoreSubmitter    Int
  scoreOther        Int
  status            String    @default("awaiting_approval") // awaiting_approval | approved | disputed
  approvedBy        String?
  resolutionNote    String?
  createdAt         DateTime  @default(now())
  challenge         Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model ChallengePrompt {
  challengeId String
  userId      String
  shownAt     DateTime @default(now())

  @@id([challengeId, userId])
}

model GzConsole {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
}

model GzGame {
  id     String  @id @default(cuid())
  title  String  @unique
  active Boolean @default(true)
}

model GzPlan {
  players           Int    @id // 1 | 2 | 4
  label             String
  ratePerPersonHour Int
}

model GzBooking {
  id            String    @id @default(cuid())
  code          String    @unique
  userId        String?
  guestName     String?
  guestPhone    String?
  consoleId     String
  gameTitle     String
  date          String
  startHour     Int
  hours         Int
  players       Int
  total         Int
  clubDiscount  Int       @default(0) // Unique Club discount already taken off total
  paymentMethod String
  paymentStatus String    @default("pending") // pending | pay_at_venue | paid | refunded
  status        String    @default("confirmed") // confirmed | completed | cancelled | expired
  holdExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([consoleId, date])
  @@index([userId])
}

model ArrivalCheckin {
  refId        String    @id // booking id or gamezone code
  userId       String
  confirmedAt  DateTime  @default(now())
  snoozedUntil DateTime?
  alertedAt    DateTime?
}

model TournamentRound {
  id           String            @id @default(cuid())
  tournamentId String
  name         String
  position     Int
  matches      TournamentMatch[]

  @@index([tournamentId])
}

model TournamentMatch {
  id        String          @id @default(cuid())
  roundId   String
  home      String?
  away      String?
  status    String          @default("upcoming") // upcoming | live | finished
  homeScore Int?
  awayScore Int?
  note      String?
  startsAt  DateTime?
  venue     String?
  round     TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  follows   MatchFollow[]
  goals     MatchGoal[]

  @@index([roundId])
}

// One goal of a match (side, minute and scorer are shown on the customer tie-sheet). Entered in the admin portal. Removed with the match.
model MatchGoal {
  id        String          @id @default(cuid())
  matchId   String
  side      String // home | away
  minute    Int?
  scorer    String?
  createdBy String?
  createdAt DateTime        @default(now())
  match     TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

// A customer who asked for live updates of one tie-sheet match. Removed with the match.
model MatchFollow {
  id        String          @id @default(cuid())
  userId    String
  matchId   String
  createdAt DateTime        @default(now())
  match     TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

// One row per booked hour. The unique (date, hour) is the final guard against two bookings taking the same hour.
model BookingSlot {
  id        String   @id @default(cuid())
  date      String
  hour      Int
  bookingId String
  createdAt DateTime @default(now())

  @@unique([date, hour])
  @@index([bookingId])
}

// One row per console and booked hour: the unique index is the final guard against double booking a console.
model GzSlot {
  id          String @id @default(cuid())
  consoleId   String
  date        String
  hour        Int
  bookingCode String

  @@unique([consoleId, date, hour])
  @@index([bookingCode])
}

model PlayerGameStat {
  id         String   @id @default(cuid())
  bookingId  String
  userId     String
  goals      Int      @default(0)
  assists    Int      @default(0)
  recordedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bookingId, userId])
  @@index([userId])
}

// Customer complaints (Popular > Complaints). Photos are URLs of compressed JPEGs; staff reply from the admin side.
model Complaint {
  id          String    @id @default(cuid())
  code        String    @unique // short code the customer sees: CP-XXXXXX
  userId      String // User.phoneNumber
  category    String
  message     String
  bookingCode String?
  photos      String[]  @default([])
  status      String    @default("open") // open | in_review | resolved | closed
  staffReply  String?
  repliedBy   String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

// A customer request for wheelchair access or help on a visit (customer app, Quick Access, Wheelchair Request).
// Staff confirm or decline it in the admin portal and the customer is told in the app. Code: WC-XXXXXX.
model WheelchairRequest {
  id          String   @id @default(cuid())
  code        String   @unique
  userId      String // User.phoneNumber
  date        String // YYYY-MM-DD, the day they are coming
  time        String // HH:MM, about when they arrive
  people      Int      @default(1) // how many wheelchair users
  note        String?
  bookingCode String?
  status      String   @default("pending") // pending | confirmed | completed | declined | cancelled
  staffReply  String?
  repliedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status, date])
}

// An insurance claim for an injury at the venue (customer app, Quick Access > Claim Insurance). The patient must have a
// Unique Futsal account. Staff review, approve or reject it in the admin portal and the filer is told in the app. Code: IC-XXXXXX.
model InsuranceClaim {
  id            String    @id @default(cuid())
  code          String    @unique
  userId        String // User.phoneNumber of whoever filed it
  patientName   String
  patientPhone  String // the patient's registered User.phoneNumber
  witnessName   String
  witnessNameNe String // the witness's name in Nepali (Devanagari)
  witnessPhone  String?
  severity      String // minor | emergency
  incidentDate  String // YYYY-MM-DD
  description   String?
  photos        String[]  @default([])
  status        String    @default("submitted") // submitted | in_review | approved | rejected | closed
  staffReply    String?
  repliedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([patientPhone])
  @@index([status, createdAt])
}

// Each time someone slides "Call emergency contact" for a player: who asked, for whom, and whether a contact was found.
// Kept so a phone number lookup is never silent (and to limit how often one account can look numbers up).
model EmergencyCall {
  id           String   @id @default(cuid())
  callerId     String // User.phoneNumber of the person who slid
  patientPhone String
  found        Boolean
  createdAt    DateTime @default(now())

  @@index([callerId, createdAt])
  @@index([patientPhone])
}

// A VIP discount code staff give to ONE customer (admin portal > Customers). type percent | flat. After the customer
// types it once (claimedAt is set) it is applied to every booking they make, until staff pause or remove it.
model VipCode {
  id        String    @id @default(cuid())
  userId    String    @unique // User.phoneNumber
  code      String // upper case, e.g. ADMINVIP
  type      String // percent | flat
  value     Int // percent (1-100) or rupees off
  active    Boolean   @default(true)
  note      String?
  claimedAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([code])
}

// Children's Academy (ages 10 to 14). Staff publish classes; a guardian enrols a child. Terms live in Settings key "academyTerms".
model AcademySession {
  id          String              @id @default(cuid())
  title       String              @default("Children's Academy class")
  date        String // YYYY-MM-DD
  startTime   String // HH:mm
  endTime     String
  capacity    Int                 @default(15)
  coach       String?
  visible     Boolean             @default(true) // staff decide when a class is shown to guardians
  status      String              @default("open") // open | cancelled
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  enrollments AcademyEnrollment[]

  @@index([date, visible])
}

model AcademyEnrollment {
  id              String         @id @default(cuid())
  code            String         @unique // AC-XXXXXX
  sessionId       String
  userId          String // the guardian's account (User.phoneNumber)
  guardianName    String
  guardianPhone   String
  emergencyPhone  String
  address         String
  childName       String
  childKey        String // lower-case name: the same child cannot be enrolled twice in one class
  childAge        Int
  healthStatus    String // healthy | condition
  healthNotes     String?
  termsVersion    Int
  termsAcceptedAt DateTime
  status          String         @default("confirmed") // confirmed | cancelled | attended | no_show
  cancelledAt     DateTime?
  cancelledBy     String? // guardian | staff
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  session         AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, childKey])
  @@index([userId])
  @@index([sessionId, status])
}

// Refer & Earn: a customer booked a game for another team; staff approve it and both get points (migration 20261011000001_refer_earn).
model Referral {
  id             String    @id @default(cuid())
  code           String    @unique // RF-XXXXXX
  referrerId     String // the customer who booked (User.phoneNumber)
  friendId       String // captain of the other team (User.phoneNumber)
  teamName       String
  bookingId      String    @unique // a booking can be referred once
  bookingCode    String?
  gameDate       String
  gameTime       String
  status         String    @default("pending") // pending | approved | rejected
  referrerPoints Decimal   @db.Decimal(8, 1)
  friendPoints   Decimal   @db.Decimal(8, 1)
  staffNote      String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([referrerId])
  @@index([friendId])
  @@index([status, createdAt])
}

// Site content: gallery photos and ads, uploaded in the admin portal (migration 20261012000001_site_content).
model ContentMedia {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  width     Int
  height    Int
  bytes     Int
  createdBy String
  createdAt DateTime @default(now())
}

model SiteGallery {
  id          String   @id @default(cuid())
  title       String
  caption     String?
  mediaId     String   @unique
  orientation String // landscape | portrait | square
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
}

// Corporate Network: logos of the companies and institutions the venue works with. Staff manage them in the admin portal
// (Corporate Network); the customer app shows them as a moving strip on Home. The picture lives in ContentMedia.
model SitePartner {
  id        String   @id @default(cuid())
  name      String
  mediaId   String   @unique
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
}

model SiteAd {
  id                String   @id @default(cuid())
  title             String
  mediaId           String   @unique
  linkUrl           String? // https://... or an in-app path such as /book
  placement         String // header | footer | popup | inline
  displaySeconds    Int      @default(6) // how long each ad shows before the next one in the loop
  popupDelaySeconds Int      @default(3)
  popupFrequency    String   @default("day") // session | day | always
  startDate         String? // YYYY-MM-DD
  endDate           String?
  dailyStart        String? // HH:mm, with dailyEnd: only show in this window (Nepal time)
  dailyEnd          String?
  days              Int[]    @default([]) // 0 = Sunday ... 6 = Saturday; empty = every day
  priority          Int      @default(0)
  active            Boolean  @default(true)
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([placement, active])
}

// Final bill made by staff at the counter: goods and/or games paid together (migration 20261013000001_checkouts).
model Checkout {
  id            String   @id @default(cuid())
  code          String   @unique // CB-XXXXXX
  userId        String
  paymentMethod String // cash | online
  goodsTotal    Int      @default(0)
  gameTotal     Int      @default(0)
  total         Int
  lines         String // JSON: [{type: "game"|"goods", label, quantity, amount}]
  bookingIds    String[] @default([])
  goodsSaleId   String?
  pointsGoods   Decimal  @default(0) @db.Decimal(8, 1)
  pointsGames   Decimal  @default(0) @db.Decimal(8, 1)
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// Digital ID: the opaque, random value inside the customer's QR code. No personal data is in it. Only staff signed in to
// the admin portal can turn it back into a customer. The customer can replace it (the old QR then stops working).
model DigitalId {
  userId    String    @id
  token     String    @unique
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
}

// One row per visitor per Nepal day: a random id the browser made for itself (no name, phone, IP or device details).
// The admin portal counts these for "Website visits" on its Overview page.
model SiteVisit {
  id         String   @id @default(cuid())
  day        String
  visitor    String
  registered Boolean  @default(false)
  pages      Int      @default(1)
  firstAt    DateTime @default(now())
  lastAt     DateTime @default(now())

  @@unique([day, visitor])
  @@index([day])
}

// Hours the venue has closed (repairs, events). Written by the admin portal, read here so the hour is not offered.
model SlotBlock {
  id        String   @id @default(cuid())
  date      String
  hour      Int
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([date, hour])
}

// Chat between registered customers: one to one ("direct") or a group. Members are User.phoneNumber values.
model ChatThread {
  id            String        @id @default(cuid())
  kind          String // direct | group
  name          String? // groups only
  directKey     String?       @unique // "phoneA|phoneB" (sorted), direct chats only: one thread per pair
  inviteCode    String?       @unique // groups only: the code in the share link
  createdBy     String
  lastMessage   String?
  lastSenderId  String?
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  members       ChatMember[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
}

model ChatMember {
  id         String     @id @default(cuid())
  threadId   String
  userId     String
  role       String     @default("member") // admin | member
  lastReadAt DateTime   @default(now())
  joinedAt   DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// Find Player: someone asks for more players for a game ("I need 6 players"). Every registered customer is notified;
// they tap "I'm in" to join until the spots are full.
model PlayerRequest {
  id            String              @id @default(cuid())
  userId        String // poster, User.phoneNumber
  date          String // YYYY-MM-DD
  startHour     Int
  playersNeeded Int
  ageGroup      String              @default("open") // open | 15-20 | 20-25 | 25-30 | 30-35 | 35-40 | 40+
  note          String?
  status        String              @default("open") // open | awaiting_advance | confirmed | cancelled
  courtPrice    Int                 @default(0) // the court price for that hour when it was posted
  bookingId     String? // the court booking made when the host pays the advance
  advanceDueAt  DateTime? // once everyone has joined, the host has until then to pay the advance
  createdAt     DateTime            @default(now())
  joins         PlayerRequestJoin[]

  @@index([date, status])
  @@index([userId, createdAt])
}

model PlayerRequestJoin {
  id        String        @id @default(cuid())
  requestId String
  userId    String // User.phoneNumber
  createdAt DateTime      @default(now())
  request   PlayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
}

// Unique Club: Rs. 1,500 for 30 days, 10% off court bookings, Gamezone and hosted tournaments. Promo and VIP codes are
// not used with it. A member is active while validUntil is in the future.
model ClubMember {
  id         String   @id @default(cuid())
  userId     String   @unique // User.phoneNumber
  validUntil DateTime
  startedAt  DateTime @default(now())
  lastPaidAt DateTime @default(now())
  payments   Int      @default(1) // how many monthly payments so far
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([validUntil])
}

// Unique Goal Rush: a 5-shot penalty game against a goalkeeper the server plays. Up to 3 games a day (every game started
// counts); a finished game with at least one goal earns 2 loyalty points (a LoyaltyEntry of kind goal_rush, one per game).
model GoalRushGame {
  id         String         @id @default(cuid())
  userId     String // User.phoneNumber
  day        String // YYYY-MM-DD (Nepal time): the day the game counts for
  status     String         @default("active") // active | completed | abandoned
  shotsTaken Int            @default(0)
  goals      Int            @default(0)
  saves      Int            @default(0)
  misses     Int            @default(0) // wide, over the bar or off the post
  points     Int            @default(0) // loyalty points this game earned (0 or 2)
  rewardId   String? // LoyaltyEntry.id of the reward
  startedAt  DateTime       @default(now())
  lastShotAt DateTime?
  finishedAt DateTime?
  shots      GoalRushShot[]

  @@index([userId, day])
  @@index([status, startedAt])
  @@index([day])
}

model GoalRushShot {
  id        String       @id @default(cuid())
  gameId    String
  no        Int // 1..5
  aimX      Float // where the player aimed (goal units: -1..1 between the posts, 0..1 up to the bar)
  aimY      Float
  power     Float // 0..1
  ballX     Float // where the ball actually went (decided by the server)
  ballY     Float
  keeper    String // the zone the goalkeeper dived to: TL TC TR BL BC BR
  outcome   String // goal | save | wide | over | post
  createdAt DateTime     @default(now())
  game      GoalRushGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, no])
}

// Gift Card: a customer buys loyalty points (Rs. 10 a point) or books and pays a game for a registered friend
// (migration 20261029000001_gift_cards). Points gifts are paid with their own order (code = Gift.code); a game gift is a
// normal booking on the friend's account, paid by the buyer (order code = the booking id).
model Gift {
  id        String    @id @default(cuid())
  code      String    @unique // GIFT-XXXXXXXX
  kind      String // points | game
  buyerId   String // phone of the customer who pays
  friendId  String // phone of the friend who receives it
  points    Int? // points gifts
  bookingId String?   @unique // game gifts
  amount    Int // rupees paid
  message   String?
  status    String    @default("pending") // pending | paid | expired | refunded (cancelled by the venue, buyer paid back)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([buyerId, createdAt])
  @@index([friendId])
}

// Friends (Chat tab): one row per pair of customers. A request is "pending" until the other person accepts; declining or
// removing deletes the row. Members are User.phoneNumber values.
model Friendship {
  id          String    @id @default(cuid())
  pairKey     String    @unique // "phoneA|phoneB" (sorted): one row per pair
  requesterId String
  addresseeId String
  status      String    @default("pending") // pending | accepted
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([requesterId, status])
  @@index([addresseeId, status])
}

// Paid AC EV charging at the venue (Rs. 50 per hour by default): one row per charging session, paid in cash and/or online.
model EvCharge {
  id           String    @id @default(cuid())
  customerName String?
  phone        String?
  vehicle      String?
  hours        Int       @default(0)
  rate         Int
  amount       Int
  cashAmount   Int       @default(0)
  onlineAmount Int       @default(0)
  createdBy    String
  createdAt    DateTime  @default(now())
  portId       String? // the charging port the customer scanned (app sessions)
  userId       String? // the customer's account (phone) for app sessions
  status       String    @default("paid") // charging | unpaid | paid | cancelled
  source       String    @default("staff") // staff | app
  startedAt    DateTime?
  endedAt      DateTime?
  paidAt       DateTime?
  minutes      Int       @default(0)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([portId, status])
}

// A charging port with its own QR code (qrToken) printed at the station. Customers scan it in the app to start charging.
model EvPort {
  id        String   @id @default(cuid())
  name      String
  note      String?
  qrToken   String   @unique
  isActive  Boolean  @default(true)
  provider       String   @default("manual") // manual | webhook: what switches the plug on and off
  providerConfig String? // JSON for the provider (webhook url and secret, device id)
  createdAt DateTime @default(now())
}

// Document verification: a short code on a receipt (kind "payment") or on a document staff made for a school, bank or college
// (kind "document"). Anyone can type the code on the customer site to see whether it is genuine and, if so, what it covers.
// The code is 4 digits (5 or 6 only when every shorter code is used). A payment code points at the paid record; a document
// code carries its own text and photos (ContentMedia ids). A revoked code no longer verifies.
model DocVerification {
  id         String    @id @default(cuid())
  code       String    @unique
  kind       String // payment | document
  sourceType String? // payment: checkout | booking | gamezone
  sourceId   String?
  title      String?
  issuedTo   String?
  orgType    String? // school | bank | college | company | other
  details    String?
  mediaIds   String[]  @default([])
  issuedBy   String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([sourceType, sourceId])
  @@index([kind, createdAt])
}

// Watch & Earn: a customer watches ads one after another. Each ad must run its full 15 seconds (the server times it);
// every 40 counted ads (10 minutes) write 1 loyalty point (a LoyaltyEntry of kind watch_earn, one per block of 40).
model WatchEarnView {
  id        String    @id @default(cuid())
  userId    String // User.phoneNumber
  adId      String? // the ad that was shown, for the record
  day       String // YYYY-MM-DD (Nepal time)
  status    String    @default("active") // active | counted | abandoned
  startedAt DateTime  @default(now())
  countedAt DateTime?

  @@index([userId, status])
  @@index([userId, day])
  @@index([status, startedAt])
}

model WatchEarnStat {
  userId    String   @id
  views     Int      @default(0) // ads counted, all time
  points    Int      @default(0) // points written so far (views / 40, rounded down)
  updatedAt DateTime @default(now()) @updatedAt
}
