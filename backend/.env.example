# Copy to .env and fill in. NEVER commit .env. NEVER paste production values into this example file.
NODE_ENV=development
PORT=5000

# Local development database (docker compose up -d). Outside production this MUST be a local host.
DATABASE_URL="postgresql://unique:unique_dev_pw@localhost:5439/unique_dev?schema=public"
ALLOWED_ORIGINS=http://localhost:3000

# Random strings, at least 16 characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=30d

# Codes by SMS (/auth/otp/*) are NOT used by the app: sign-up and sign-in are phone + password, and a forgotten password is reset by the venue or with Google.
# The code routes stay in the server, off for customers. Set REQUIRE_SIGNUP_OTP=true only if a working SMS provider is added and the sign-up page is changed to use it.
# OTP / SMS is OFF. Keep false until the owner decides to enable it.
OTP_ENABLED=false
SPARROW_SMS_TOKEN=
SPARROW_SMS_IDENTITY=
# Which sender sends the booking texts: "android" (our own SIM through the SMS Gateway for Android app, cloud mode) or "sparrow" (default).
SMS_PROVIDER=sparrow
# Android gateway: the username and password the app shows under Cloud Server (also the login of https://dashboard.sms-gate.app)
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_SIM=0
SMSGATE_TTL_SECONDS=3600

# Payments: customers pay the venue's one fixed Fonepay QR and write the booking code as the remark; staff confirm it in the admin portal.
# There is no payment gateway to configure.

# Cloudflare R2 (invoices, images). Leave empty locally.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Used only by scripts/create-superadmin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Google sign-in (password reset 2FA): OAuth Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Face ID / fingerprint sign-in (passkeys): the site domain (no port) and its exact addresses
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000

# Optional TURN relay for voice calls (JSON). Empty = free STUN only.
ICE_SERVERS=
