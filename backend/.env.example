# Copy to .env and fill in. NEVER commit .env. NEVER paste production values into this example file.
NODE_ENV=development
PORT=5000

# Local development database (docker compose up -d). Outside production this MUST be a local host.
DATABASE_URL="postgresql://unique:unique_dev_pw@localhost:5439/unique_dev?schema=public"
ALLOWED_ORIGINS=http://localhost:3000

# Random strings, at least 16 characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=30d

# OTP / SMS is OFF. Keep false until the owner decides to enable it.
OTP_ENABLED=false
SPARROW_SMS_TOKEN=
SPARROW_SMS_IDENTITY=

# Payments: "test" uses a local fake gateway. Real eSewa/Fonepay adapters need merchant keys.
PAYMENT_GATEWAY=test
ESEWA_MERCHANT_CODE=
ESEWA_SECRET=
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET=

# Cloudflare R2 (invoices, images). Leave empty locally.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Used only by scripts/create-superadmin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Google sign-in (password reset 2FA): OAuth Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
